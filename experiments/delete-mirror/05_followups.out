== delete sibling then insert at top: priority computation after delete
--- create 'P priorities'
    POST /api/v1/nodes
    req: {"parent_id":"2882eb89-25a3-4d38-94be-5335447681ab","name":"P priorities","position":"bottom"}
    -> 200 content-type=application/json
    {"item_id": "859b7a68-4039-4b49-a936-7dcddcc1dcb6"}
--- create 'p1'
    POST /api/v1/nodes
    req: {"parent_id":"859b7a68-4039-4b49-a936-7dcddcc1dcb6","name":"p1","position":"bottom"}
    -> 200 content-type=application/json
    {"item_id": "03aaebbf-b7ed-4094-a6ac-6dbb5901b17a"}
--- create 'p2'
    POST /api/v1/nodes
    req: {"parent_id":"859b7a68-4039-4b49-a936-7dcddcc1dcb6","name":"p2","position":"bottom"}
    -> 200 content-type=application/json
    {"item_id": "cd313ab8-e950-4278-b4db-16362228f60e"}
--- create 'p3'
    POST /api/v1/nodes
    req: {"parent_id":"859b7a68-4039-4b49-a936-7dcddcc1dcb6","name":"p3","position":"bottom"}
    -> 200 content-type=application/json
    {"item_id": "155f0ec8-dc4f-4012-9a16-b50ef9b975f8"}
--- DELETE p1 (lowest priority)
    DELETE /api/v1/nodes/03aaebbf-b7ed-4094-a6ac-6dbb5901b17a
    -> 200 content-type=application/json
    {"status": "ok"}
--- create 'new top after deleting p1'
