    {"node": {"completed": false, "completedAt": null, "createdAt": 1791834612, "data": {"layoutMode": "bullets"}, "id": "7d5d22ad-2a2c-44df-ad2d-31a81c9991c0", "modifiedAt": 1791834612, "name": "", "note": "", "parent_id": "1727b2c2-3976-488e-8e65-44d2b0b4fdd2", "priority": 200}}
