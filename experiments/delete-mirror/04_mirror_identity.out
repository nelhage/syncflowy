    req: {"parent_id":"532a07fa-2a20-477d-86df-0d721ef92956","name":"C (second mirror dest)","position":"bottom"}
    -> 200 content-type=application/json
    {"item_id": "29c8eedd-d4ef-4ae7-b66d-a9ac54948b98"}
--- create 'O origin'
    POST /api/v1/nodes
    req: {"parent_id":"5a117ed4-3d3a-4ec1-a1aa-0fec2ac3d78b","name":"O origin"}
    -> 200 content-type=application/json
    {"item_id": "66590f9d-4ea3-4768-b34c-d85e10fb45a3"}
