// A node cut from another managed file and pasted here is a move (§6.4). A child
// typed under it is created first, in its old place (creates come before moves,
// §7.1), and travels with it.
== config
roots other
== remote
home
  root
    a A
    b B
  other
    o O
      o1 O one
    p P
== merged
root
  a A
  o O
    o1 O one
    +1 Typed under O
  b B
== ops
create +1 in o direct "Typed under O" note=None layout=bullets
move o to root bottom (from other)
move b to root bottom (from root)
